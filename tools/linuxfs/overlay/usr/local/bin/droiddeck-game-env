#!/usr/bin/python3
import json
import os
import re
import runpy
import select
import signal
import subprocess
import sys
import time
from pathlib import Path

SYNC_KEYS = ("BL_SYNC_FALLBACK", "BL_FSYNC_FIRST", "BL_SYNC_MIN_NOFILE", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC", "PROTON_NO_NTSYNC", "WINEESYNC")
SEED_REDISTS = "/usr/local/bin/droiddeck-seed-redists"
PACK_KEYS = ("WINESERVER", "BL_SYNC_PACK", "WINEESYNC", "PROTON_NO_ESYNC", "PROTON_NO_FSYNC")
SYNC_OFF = ("off", "0", "no", "none", "stock")
TRUTHY = ("1", "on", "true", "yes")

# Every launch is run with these channels on: a game that dies in its first seconds says why
# through them - a missing DLL is an err:module line, a crash is an err:seh one with the fault
# address - and Proton otherwise silences all of Wine (WINEDEBUG=-all) in a session where nothing
# else is kept.
WINEDEBUG_GAMES = "-all,+seh,+module"

# What the launch record keeps from the environment: the settings that decide how this launch is
# run, so a log can be read without the session's environment around it.
DEBUG_KEYS = (
    "WINEDEBUG", "PROTON_LOG", "PROTON_LOG_DIR", "WINEESYNC", "WINEFSYNC", "WINESERVER",
    "PROTON_NO_ESYNC", "PROTON_NO_FSYNC", "PROTON_NO_NTSYNC", "PROTON_USE_PIPEWIRE", "PROTON_USE_ARM64",
    "BL_SYNC", "BL_SYNC_PACK", "BL_FSYNC", "BL_SYNC_FALLBACK", "BL_FSYNC_FIRST", "BL_SYNC_MIN_NOFILE",
    "BL_GAME_CPUS", "BL_DIRECTAUDIO", "WINE_AUDIO_DRIVER", "LD_PRELOAD", "LD_LIBRARY_PATH", "WINEDLLPATH",
    "DROIDDECK_SYNC", "DROIDDECK_AUDIO", "DROIDDECK_NO_STEAM", "DROIDDECK_FORCE_SSBS", "DROIDDECK_VERBOSE",
    "DXVK_CONFIG", "DXVK_HUD", "MANGOHUD", "VKD3D_FEATURE_LEVEL", "VKD3D_SHADER_MODEL", "VKD3D_CONFIG",
    "DOTNET_GCRegionRange", "DOTNET_EnableWriteXorExecute", "FEX_ROOTFS", "FEX_TSOENABLED",
    "FEX_VECTORTSOENABLED", "FEX_MEMCPYSETTSOENABLED", "FEX_HALFBARRIERTSOENABLED",
    "FEX_X87REDUCEDPRECISION", "FEX_MULTIBLOCK", "FEX_SMCCHECKS", "FEX_UNALIGNEDATOMICS",
)

# The Steamworks emulators a repack drops next to the game: the client library has to come from
# Steam (or from Proton's own bridge), so a game folder that carries its own steals the game's
# Steam API and leaves it unable to start.
EMULATOR_FILES = frozenset((
    "steamclient.dll", "steamclient64.dll", "steamclient_loader.exe", "steamclient_loader_x86.exe",
    "steam_settings", "steam_emu.ini", "cream_api.ini", "smartsteamemu.ini", "coldclientloader.ini",
    "coldclientloader.exe", "valve.ini", "hlm.ini", "steam_appid.txt", "goldberg", "steam_api.txt",
))
STEAM_LIBRARIES = ("steam_api.dll", "steam_api64.dll", "steamclient.dll", "steamclient64.dll")
UNITY_LOGS = frozenset(("player.log", "player-prev.log", "output_log.txt"))
GAME_LOG_CAP = 8 * 1024 * 1024
ARTIFACT_CAP = 1024 * 1024
PROTON_LOG_CAP = 4 * 1024 * 1024
ARTIFACTS_TOTAL = 8 * 1024 * 1024
ARTIFACTS_LIMIT = 16
SCAN_LIMIT = 4000


def game_id(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not prefix:
        return None
    value = prefix.rsplit("/", 1)[-1]
    if not re.fullmatch(r"-?[0-9]+", value):
        return None
    number = int(value)
    if not -(2**31) <= number < 2**32 or number == 0:
        return None
    return str(number % 2**32)


DOTNET_FEX = {
    "FEX_TSOENABLED": "1",
    "FEX_VECTORTSOENABLED": "1",
    "FEX_MEMCPYSETTSOENABLED": "1",
    "FEX_HALFBARRIERTSOENABLED": "1",
    "FEX_X87REDUCEDPRECISION": "0",
    "FEX_MULTIBLOCK": "0",
}


def game_files(exe):
    """Lower-cased names of the files next to the game's executable and one directory below."""
    names = set()
    folder = os.path.dirname(exe)
    try:
        with os.scandir(folder) as top:
            for entry in top:
                names.add(entry.name.lower())
                if entry.is_dir(follow_symlinks=False):
                    try:
                        with os.scandir(entry.path) as inner:
                            names.update(e.name.lower() for e in inner)
                    except OSError:
                        pass
    except OSError:
        pass
    return names


class Game:
    """What a fix gets to look at: the executable, its launch arguments and the files beside it."""

    def __init__(self, exe, args):
        self.exe = exe
        self.args = args
        self.stem = os.path.splitext(os.path.basename(exe))[0].lower()
        self.files = game_files(exe)

    def has_arg(self, name):
        return any(a == name or a.startswith(name + "=") for a in self.args)


FIXES = []


def fix(function):
    FIXES.append(function)
    return function


def is_godot(game):
    return game.stem + ".pck" in game.files or "godotsharp.dll" in game.files


@fix
def dotnet_memory_ordering(game):
    if "coreclr.dll" in game.files:
        return DOTNET_FEX, [], ".NET runtime: FEX with full TSO and without multiblock"


@fix
def godot_vulkan(game):
    if is_godot(game) and not game.has_arg("--rendering-driver"):
        return {}, ["--rendering-driver", "vulkan"], "Godot: Vulkan renderer"


@fix
def godot_sentry(game):
    sentry = sorted(n[:-4] for n in game.files if n.startswith("libsentry.windows.") and n.endswith(".dll"))
    if is_godot(game) and sentry:
        return {"WINEDLLOVERRIDES": ";".join(n + "=d" for n in sentry)}, [], "Godot: Sentry crash handler off"


@fix
def arkham_city_x87(game):
    """Batman: Arkham City (BatmanAC.exe, also started through BmLauncher.exe beside it) leans on x87
    and stops with Unreal's "Fatal error!" right after start when FEX reduces its precision."""
    if "batmanac.exe" in game.files:
        return {"FEX_X87REDUCEDPRECISION": "0"}, [], "Batman: Arkham City: FEX with full x87 precision"


def skip_red_launcher(command):
    """Cyberpunk 2077's prelauncher opens REDlauncher, a Qt WebEngine window that hands over to the
    game half a minute later and then stays up beside it, well over a core busy for as long as the
    game runs. The game is started itself instead; the prelauncher's own --launcher-skip started it
    twice."""
    if len(command) > 2 and os.path.basename(command[2]).lower() == "redprelauncher.exe":
        game = os.path.join(os.path.dirname(command[2]), "bin", "x64", "Cyberpunk2077.exe")
        if os.path.isfile(game):
            print("droiddeck-game-env: REDlauncher skipped", file=sys.stderr)
            return command[:2] + [game] + command[3:]
    return command


def engine_fixes(exe, args):
    """Environment and extra arguments a game needs because of what it is built with."""
    game = Game(exe, args)
    env, extra, notes = {}, [], []
    for check in FIXES:
        found = check(game)
        if found:
            env.update(found[0])
            extra += found[1]
            notes.append(found[2])
    return env, extra, notes


def win_components(compat, app_id):
    """The game's Windows components put into its prefix; returns their WINEDLLOVERRIDES entries."""
    if not compat:
        return ""
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wincomponents"))
        names, notes = module["apply"](compat.rstrip("/"), app_id)
        for note in notes:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        return module["overrides_value"](names)
    except Exception as error:
        print("droiddeck-game-env: Windows components not applied (%s)" % error, file=sys.stderr)
        return ""


def apply_config(env, config, app_id, fixes=None):
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    result = env.copy()
    entries = dict(config.get("shared", {}))
    for name, value in (fixes or {}).items():
        if name == "WINEDLLOVERRIDES" and entries.get(name, env.get(name)):
            value = entries.get(name, env.get(name)) + ";" + value
        entries[name] = value
    entries.update(config.get("games", {}).get(app_id, {}))
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None:
            result.pop(name, None)
        elif isinstance(value, str) and "\0" not in value and len(value) <= 8192:
            result[name] = value
        else:
            raise ValueError("invalid environment value")
    game_dxvk = config.get("dxvkConfigGames", {})
    if not isinstance(game_dxvk, dict):
        raise ValueError("invalid game dxvk configuration")
    dxvk = game_dxvk.get(app_id, config.get("dxvkConfig"))
    if dxvk is not None:
        if not isinstance(dxvk, str) or "\0" in dxvk or len(dxvk) > 8192:
            raise ValueError("invalid dxvk configuration")
        if dxvk:
            own = result.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
            result["DXVK_CONFIG"] = own + "; " + dxvk if own else dxvk
    return result


def sync_config(config, app_id):
    games = config.get("games", {})
    return {
        "version": config.get("version"),
        "shared": {name: value for name, value in config.get("shared", {}).items() if name in SYNC_KEYS},
        "games": {app_id: {name: value for name, value in games.get(app_id, {}).items() if name in SYNC_KEYS}},
    }


def load_sync():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-esync"))
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
        return None


def select_sync(command, env, sync=None):
    try:
        sync = sync if sync is not None else load_sync()
        if sync is None:
            return command, env
        chosen, chosen_env = sync["select"](command, env)
        if chosen and all(isinstance(value, str) for value in chosen) and isinstance(chosen_env, dict):
            return list(chosen), dict(chosen_env)
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
    return command, env


def record_stock(sync, command, env):
    try:
        if sync is not None and "record" in sync:
            sync["record"](command, env)
    except Exception as error:
        print("droiddeck-game-env: stock launch not recorded (%s)" % error, file=sys.stderr)


def without_pack(chosen_env, env):
    result = dict(chosen_env)
    for name in PACK_KEYS:
        if name in env:
            result[name] = env[name]
        else:
            result.pop(name, None)
    return result


SSBS_LIB = "/usr/local/lib/libssbs.so"


def force_ssbs(command, env):
    """DROIDDECK_FORCE_SSBS=1 (a game's or the shared environment): preload libssbs.so into this
    Proton's Wine, which then keeps PSTATE.SSBS set across signal returns - speculative store
    bypass stays allowed, as force_ssbs.diff does inside a rebuilt ntdll. ARM64 Protons only: the
    library is aarch64 and only arm64 Wine has the signal path it fixes."""
    if env.get("DROIDDECK_FORCE_SSBS", "").lower() not in ("1", "on", "true", "yes"):
        return env
    proton = os.path.dirname(command[0]) if command else ""
    if not os.path.isdir(os.path.join(proton, "files/lib/wine/aarch64-unix")):
        print("droiddeck-game-env: force SSBS asked for, but this Proton is not an ARM64 one; left off", file=sys.stderr)
        return env
    if not os.path.isfile(SSBS_LIB):
        print("droiddeck-game-env: force SSBS asked for, but %s is missing; left off" % SSBS_LIB, file=sys.stderr)
        return env
    parts = [p for p in re.split(r"[:\s]+", env.get("LD_PRELOAD", "")) if p]
    if SSBS_LIB not in parts:
        env = dict(env, LD_PRELOAD=":".join(parts + [SSBS_LIB]))
        print("droiddeck-game-env: force SSBS on (libssbs.so preloaded)", file=sys.stderr)
    return env


def umu_capable(proton):
    """Whether this Proton's script has umu's launch without Steam: GE-Proton, Proton-CachyOS and
    DroidDeck-Proton run umu.exe in place of steam.exe when UMU_ID is set; Valve's Proton does not."""
    try:
        with open(proton, encoding="utf-8", errors="replace") as source:
            text = source.read()
    except OSError:
        return False
    return "UMU_ID" in text and "umu.exe" in text


def start_without_steam(command, env, app_id):
    """DROIDDECK_NO_STEAM=1 (a game's Start without Steam): launch the game without Proton's
    steam.exe, for games that close right away because of what it sets up. A Proton with umu's
    launch gets UMU_ID - Proton still sets up the prefix, and a Steam game keeps its protonfixes
    under its own id; any other Proton runs the game straight in the prefix (runinprefix)."""
    if env.get("DROIDDECK_NO_STEAM", "").lower() not in ("1", "on", "true", "yes"):
        return command, env
    if len(command) < 3 or command[1] != "waitforexitandrun":
        return command, env
    if umu_capable(command[0]):
        if not env.get("UMU_ID"):
            steam_game = app_id is not None and int(app_id) < 2**31
            env = dict(env, UMU_ID=app_id if steam_game else "0")
        print("droiddeck-game-env: starting without Steam (umu.exe in place of steam.exe, UMU_ID=%s)" % env["UMU_ID"], file=sys.stderr)
        return command, env
    print("droiddeck-game-env: starting without Steam (this Proton has no umu launch: runinprefix)", file=sys.stderr)
    return [command[0], "runinprefix"] + command[2:], env


EVALUATOR_SCRIPT = re.compile(r"(?:^|[\\/])evaluatorscript_[0-9]+\.vdf$", re.IGNORECASE)


def mark_install_scripts(command, env):
    """The client is about to run a game's install scripts (iscriptevaluator.exe): mark every process
    in them but a Vulkan runtime installer as already run first, so no redistributable installer
    starts - on first launch the shared ones may still be downloading, and on ARM64 Proton the VC++
    ones stop with an error."""
    if not any(arg.lower().replace("\\", "/").endswith("iscriptevaluator.exe") for arg in command):
        return
    root = env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(Path.home() / ".local/share/Steam")
    scripts = [str(Path(root) / arg.replace("\\", "/")) for arg in command if EVALUATOR_SCRIPT.search(arg)]
    scripts = [path for path in scripts if os.path.isfile(path)]
    if not scripts:
        return
    try:
        subprocess.run([SEED_REDISTS, root], env=dict(env, DROIDDECK_SEED_SCRIPTS="\n".join(scripts)),
                       stdout=sys.stderr, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        print("droiddeck-game-env: install scripts not marked (%s)" % error, file=sys.stderr)


def sync_off(env):
    return env.get("DROIDDECK_SYNC", "").strip().lower() in SYNC_OFF


def describe_status(status):
    if status < 0:
        return "killed by signal %d" % -status
    return "exit code %d" % status


def game_folder(app_id):
    """Where this session keeps what a game said: the folder the app collects with the session's
    logs. None outside a session, or when it cannot be made."""
    debug = os.environ.get("BL_DEBUG_DIR", "").strip()
    if not debug or not app_id:
        return None
    folder = Path(debug) / "games"
    try:
        folder.mkdir(parents=True, exist_ok=True)
    except OSError:
        return None
    return folder


class GameLog:
    """A launch's own account of itself, kept per app while it runs.

    A game that stops in its first seconds has said why somewhere - Unity writes Player.log, Wine
    writes an err:seh line with the fault or an err:module line naming a library it could not load,
    DXVK and the Vulkan layers write to the same stream - and none of it survives a session today:
    the launcher execs Proton, so the game's output only reaches the session log, which is trimmed
    to the last megabytes of the session and thrown away with it. This keeps the same output beside
    the session's artifacts, by app, whatever happens to the game.
    """

    def __init__(self, app_id):
        self.app_id = app_id or "0"
        self.folder = game_folder(app_id)
        self.path = (self.folder / (self.app_id + ".log")) if self.folder else None
        self.head = []
        self.written = 0

    def note(self, text):
        print(text, file=sys.stderr)
        self.head.append(text)

    def start(self, command, env, exe):
        lines = ["== %s  app %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), self.app_id),
                 "   command: " + " ".join(command),
                 "   exe: " + (exe or "-"),
                 "   install: " + (env.get("STEAM_COMPAT_INSTALL_PATH") or "-"),
                 "   prefix: " + (env.get("STEAM_COMPAT_DATA_PATH") or "-")]
        lines += ["   " + text for text in self.head]
        lines += ["   %s=%s" % (name, env[name]) for name in DEBUG_KEYS if env.get(name)]
        self._write(("\n".join(lines) + "\n").encode("utf-8", "replace"))

    def output(self, data, channel="err"):
        stream = sys.stdout.buffer if channel == "out" else sys.stderr.buffer
        try:
            stream.write(data)
            stream.flush()
        except (OSError, ValueError):
            pass
        self._write(data)

    def stopped(self, status, seconds):
        text = "droiddeck-game-env: app %s stopped after %.1f s (%s)" % (self.app_id, seconds, describe_status(status))
        print(text, file=sys.stderr)
        self._write(("\n" + text + "\n").encode("utf-8", "replace"))

    def _write(self, data):
        if self.path is None or self.written >= GAME_LOG_CAP:
            return
        if self.written + len(data) > GAME_LOG_CAP:
            data = data[:GAME_LOG_CAP - self.written] + b"\n...(the rest of this log was dropped)...\n"
        try:
            with self.path.open("ab") as sink:
                sink.write(data)
        except OSError:
            return
        self.written += len(data)


def prefix_files(pfx):
    """The files a game in this prefix wrote where Unity and Wine leave theirs: the game's own log,
    what it wrote to its crash folder, and Wine's dumps under the user's Temp. Read-only and
    bounded - the prefix is the user's, not this session's."""
    users = Path(pfx) / "drive_c" / "users"
    found = []
    scanned = 0
    if not users.is_dir():
        return found
    for user in sorted(users.iterdir()):
        for root, crashes in ((user / "AppData" / "LocalLow", True), (user / "AppData" / "Local" / "Temp", False)):
            if not root.is_dir():
                continue
            for base, _, names in os.walk(root):
                for name in sorted(names):
                    scanned += 1
                    if scanned > SCAN_LIMIT:
                        return sorted(set(found))
                    path = Path(base) / name
                    low = name.lower()
                    if low in UNITY_LOGS or low.endswith(".dmp") or (crashes and "crashes" in [p.lower() for p in path.parts]):
                        found.append(path)
    return sorted(set(found))


def keep_files(folder, app_id, sources, cap=ARTIFACT_CAP):
    """Copies what a game left behind into the session's artifacts - the tail of each file, since a
    log ends with what went wrong - and returns (source, kept name, bytes) for the record."""
    kept = []
    total = 0
    for path in sources:
        if len(kept) >= ARTIFACTS_LIMIT or total >= ARTIFACTS_TOTAL:
            break
        try:
            data = path.read_bytes()
        except OSError:
            continue
        if len(data) > cap:
            data = b"...(older output dropped)...\n" + data[-cap:]
        name = "%s-%s" % (app_id, path.name.lower())
        index = 1
        while (folder / name).exists():
            index += 1
            name = "%s-%d-%s" % (app_id, index, path.name.lower())
        try:
            (folder / name).write_bytes(data)
        except OSError:
            continue
        kept.append((str(path), name, len(data)))
        total += len(data)
    return kept


def proton_logs(app_id):
    """Proton's own log of a launch (PROTON_LOG=1), the one place where Wine's errors, the Vulkan
    layers and the game's setup are kept together."""
    home = Path.home()
    candidates = [home / ("steam-%s.log" % app_id), home / "steam.log"] if app_id else [home / "steam.log"]
    return [path for path in candidates if path.is_file()]


def signature(path):
    """Valve's own steam_api64.dll carries an Authenticode signature; the Steamworks emulators a
    repack leaves in its place are patched copies of it and are not signed, which is what tells the
    two apart here."""
    try:
        with path.open("rb") as source:
            head = source.read(0x40)
            if len(head) < 0x40 or head[:2] != b"MZ":
                return "not a PE file"
            offset = int.from_bytes(head[0x3C:0x40], "little")
            source.seek(offset)
            header = source.read(0x120)
    except OSError as error:
        return "unreadable (%s)" % error
    if len(header) < 0x78 or header[:4] != b"PE\x00\x00":
        return "not a PE file"
    magic = int.from_bytes(header[24:26], "little")
    table = 24 + (96 if magic == 0x10B else 112) + 4 * 8
    if table + 8 > len(header):
        return "no data directories"
    return "signed" if int.from_bytes(header[table + 4:table + 8], "little") else "unsigned"


def install_report(env, exe):
    """The game's own folder as this launch finds it: what Steam put there, and anything a repack
    left beside it. Every launch keeps one with the session's artifacts, because a game that closes
    right away is often a game whose folder was written by something other than Steam - the crack's
    steamclient64.dll shadows the client library Proton provides, and SteamAPI_Init is then the last
    thing the game does before it exits."""
    path = env.get("STEAM_COMPAT_INSTALL_PATH") or (os.path.dirname(exe) if exe else "")
    lines = ["install: " + (path or "-")]
    if not path:
        return lines
    folder = Path(path)
    try:
        entries = sorted(folder.iterdir(), key=lambda entry: entry.name.lower())
    except OSError as error:
        return lines + ["not listable (%s)" % error]
    if os.path.islink(path):
        lines.append("symlink to: " + os.path.realpath(path))
    for entry in entries[:200]:
        try:
            info = entry.stat(follow_symlinks=False)
        except OSError:
            continue
        lines.append("  %s %10d %s" % ("d" if entry.is_dir() else "f", info.st_size, entry.name))
    found = sorted(entry.name for entry in entries if entry.name.lower() in EMULATOR_FILES)
    if found:
        lines.append("steam emulator files: " + ", ".join(found))
    for name in STEAM_LIBRARIES:
        candidate = folder / name
        if candidate.is_file():
            lines.append("  %s %10d %s: %s" % ("s", candidate.stat().st_size, name, signature(candidate)))
    return lines


def keep_artifacts(log, env, exe):
    """Keeps what a launch left behind with the session's artifacts: the game's own logs and dumps,
    Proton's log, and a listing of its folder as the launch found it."""
    if log.folder is None:
        return
    pfx = os.path.join(env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/"), "pfx")
    kept = keep_files(log.folder, log.app_id, prefix_files(pfx))
    kept += keep_files(log.folder, log.app_id, proton_logs(log.app_id), cap=PROTON_LOG_CAP)
    for source, name, size in kept:
        log.note("droiddeck-game-env: kept %s (%d bytes) as %s" % (source, size, name))
    try:
        (log.folder / (log.app_id + "-install.txt")).write_text("\n".join(install_report(env, exe)) + "\n", encoding="utf-8")
    except OSError:
        pass


def start(launch, env):
    return subprocess.Popen(launch, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def follow(child, log):
    """Reads the game's output until the launch ends, then waits for it. Each stream keeps its own
    side of this process's output, so a launcher that reads the game's stdout still gets it. The
    pipes are dropped once the launch's own process is gone even if something it started still holds
    them open, so a leftover process cannot keep the client waiting for a game that has stopped."""
    previous = {}

    def forward(signum, frame):
        try:
            child.send_signal(signum)
        except OSError:
            pass

    for name in ("SIGTERM", "SIGINT", "SIGHUP"):
        previous[name] = signal.signal(getattr(signal, name), forward)
    streams = {child.stdout: "out", child.stderr: "err"}
    try:
        while streams:
            ready, _, _ = select.select(list(streams), [], [], 0.25)
            if ready:
                for stream in ready:
                    chunk = os.read(stream.fileno(), 65536)
                    if chunk:
                        log.output(chunk, streams[stream])
                    else:
                        streams.pop(stream, None)
                continue
            if child.poll() is not None:
                for stream in list(streams):
                    while select.select([stream], [], [], 0)[0]:
                        chunk = os.read(stream.fileno(), 65536)
                        if not chunk:
                            break
                        log.output(chunk, streams[stream])
                break
    except (OSError, ValueError):
        pass
    finally:
        for name, handler in previous.items():
            signal.signal(getattr(signal, name), handler)
    return child.wait()


def kill_server(command, env):
    """Stops a Wine server still running for this prefix. A server left over from the previous
    launch is reused whichever binaries the next one names, so a launch that asks for different
    ones has to end it first to be what it says it is."""
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    server = os.path.join(os.path.dirname(command[0]), "files", "bin", "wineserver")
    if not prefix or not os.path.isfile(server):
        return
    print("droiddeck-game-env: ending the Wine server still running for this prefix", file=sys.stderr)
    try:
        subprocess.run([server, "-k"], env=dict(env, WINEPREFIX=os.path.join(prefix, "pfx")), timeout=30,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def pick_launch(command, env, sync, note=print):
    """The command and environment to run, and the sync choice behind them: the pack's when the
    selector chose one, the stock pair when it did not - and always the stock pair, with the sync
    libraries taken out, when the game's own environment asks for sync off."""
    if sync_off(env):
        note("droiddeck-game-env: sync off for this game (asked for in its environment); stock launch")
        kill_server(command, env)
        return command, without_pack(env, env), None
    launch, launch_env = select_sync(command, env, sync)
    return launch, launch_env, (sync if launch[0] != command[0] else None)


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    env = os.environ.copy()
    mic_enabled = env.get("BL_MIC_ENABLED")
    mark_install_scripts(command, env)
    app_id = game_id(env)
    log = GameLog(app_id)
    if app_id:
        waiting = len(command) > 1 and command[1] == "waitforexitandrun"
        fixes = {}
        if waiting:
            if not env.get("WINEDEBUG"):
                env["WINEDEBUG"] = WINEDEBUG_GAMES
            command = skip_red_launcher(command)
            fixes, extra, notes = engine_fixes(command[2], command[3:]) if len(command) > 2 else ({}, [], [])
            for note in notes:
                log.note("droiddeck-game-env: " + note)
            command += extra
            components = win_components(env.get("STEAM_COMPAT_DATA_PATH", ""), app_id)
            if components:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = components + ";" + own if own else components
        path = Path.home() / ".config/droiddeck/game-environment.json"
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
            if waiting:
                env = apply_config(env, config, app_id, fixes)
            else:
                env = apply_config(env, sync_config(config, app_id), app_id)
        except FileNotFoundError:
            if waiting:
                env = apply_config(env, {"version": 1}, app_id, fixes)
        except (OSError, ValueError, TypeError, AttributeError):
            print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
    if mic_enabled == "0":
        env["BANNER_AUDIO_DIRECT_MIC"] = "0"
    env = force_ssbs(command, env)
    command, env = start_without_steam(command, env, app_id)
    exe = command[2] if len(command) > 2 else ""
    sync = load_sync()
    launch, launch_env, chosen_sync = pick_launch(command, env, sync, log.note)
    log.start(launch, launch_env, exe)
    began = time.monotonic()
    try:
        child = start(launch, launch_env)
    except OSError as error:
        if chosen_sync is None:
            raise
        log.note("droiddeck-game-env: %s could not start (%s); stock launch" % (launch[0], error))
        launch, launch_env = command, without_pack(launch_env, env)
        record_stock(sync, launch, launch_env)
        child = start(launch, launch_env)
    status = follow(child, log)
    log.stopped(status, time.monotonic() - began)
    keep_artifacts(log, launch_env, exe)
    return status if status >= 0 else 128 - status


if __name__ == "__main__":
    sys.exit(main())
