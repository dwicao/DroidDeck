PROTON_LOG_CAP = 4 * 1024 * 1024
ARTIFACTS_TOTAL = 8 * 1024 * 1024
ARTIFACTS_LIMIT = 16
SCAN_LIMIT = 4000

# An install that did not arrive whole cannot start, and its own manifest is what hides that: a
# copied Steam install carries the manifest of the machine it came from, so the depot record says
# the whole build is there and neither Steam nor the client asks for the part that never landed.
# The same tolerance the kit export uses, and a floor so that a rounding difference is not one.
ACF_SIZE = re.compile(r'"SizeOnDisk"\s*"(\d+)"')
ACF_BUILD = re.compile(r'"buildid"\s*"(\d+)"')
VDF_PATH = re.compile(r'"path"\s+"((?:[^"\\]|\\.)*)"')
MEASURE_LIMIT = 400000
MEASURE_SECONDS = 30.0
MEASURE_SECONDS_QUIET = 3.0
SHORT_TOLERANCE = 0.98
SHORT_BYTES = 200 * 1024 * 1024
QUICK_STOP = 60.0
BUNDLE_TAIL = re.compile(r"_[0-9a-f]{32}\.bundle$")


def game_id(env):
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    if not prefix:
        return None
    value = prefix.rsplit("/", 1)[-1]
    if not re.fullmatch(r"-?[0-9]+", value):
        return None
    number = int(value)
    if not -(2**31) <= number < 2**32 or number == 0:
        return None
    return str(number % 2**32)


DOTNET_FEX = {
    "FEX_TSOENABLED": "1",
    "FEX_VECTORTSOENABLED": "1",
    "FEX_MEMCPYSETTSOENABLED": "1",
    "FEX_HALFBARRIERTSOENABLED": "1",
    "FEX_X87REDUCEDPRECISION": "0",
    "FEX_MULTIBLOCK": "0",
}


def game_files(exe):
    """Lower-cased names of the files next to the game's executable and one directory below."""
    names = set()
    folder = os.path.dirname(exe)
    try:
        with os.scandir(folder) as top:
            for entry in top:
                names.add(entry.name.lower())
                if entry.is_dir(follow_symlinks=False):
                    try:
                        with os.scandir(entry.path) as inner:
                            names.update(e.name.lower() for e in inner)
                    except OSError:
                        pass
    except OSError:
        pass
    return names


class Game:
    """What a fix gets to look at: the executable, its launch arguments and the files beside it."""

    def __init__(self, exe, args):
        self.exe = exe
        self.args = args
        self.stem = os.path.splitext(os.path.basename(exe))[0].lower()
        self.files = game_files(exe)

    def has_arg(self, name):
        return any(a == name or a.startswith(name + "=") for a in self.args)


FIXES = []


def fix(function):
    FIXES.append(function)
    return function


def is_godot(game):
    return game.stem + ".pck" in game.files or "godotsharp.dll" in game.files


@fix
def dotnet_memory_ordering(game):
    if "coreclr.dll" in game.files:
        return DOTNET_FEX, [], ".NET runtime: FEX with full TSO and without multiblock"


@fix
def unity_memory_ordering(game):
    if {"unityplayer.so", "gameassembly.so", "unityplayer.dll"} & game.files:
        return {"FEX_TSOENABLED": "1"}, [], "Unity: FEX with TSO"


@fix
def godot_vulkan(game):
    if is_godot(game) and not game.has_arg("--rendering-driver"):
        return {}, ["--rendering-driver", "vulkan"], "Godot: Vulkan renderer"


@fix
def godot_sentry(game):
    sentry = sorted(n[:-4] for n in game.files if n.startswith("libsentry.windows.") and n.endswith(".dll"))
    if is_godot(game) and sentry and ("coreclr.dll" in game.files or "godotsharp.dll" in game.files):
        return {"WINEDLLOVERRIDES": ";".join(n + "=d" for n in sentry)}, [], "Godot: Sentry crash handler off"


@fix
def d3dgear_hook(game):
    """D3DGear's capture DLL left beside a game (The Crew 2) is loaded by it and hooks the DXGI swapchain;
    under Wine the hook faults over a thousand times within seconds and the game never presents again:
    black screen while the sound keeps playing."""
    if "d3dgear64.dll" in game.files:
        return {"WINEDLLOVERRIDES": "d3dgear64=d"}, [], "D3DGear capture hook off (it stops the game drawing)"


@fix
def deep_rock_gdk_raytracing(game):
    if game.stem == "fsd-wingdk-shipping" and not any(game.has_arg(arg) for arg in ("-raytracing", "-noraytracing")):
        return {}, ["-noraytracing", "-ini:Engine:[/Script/Engine.RendererSettings]:r.RayTracing=False"], "Deep Rock Galactic GDK: ray tracing off (D3D12 pipeline creation fails on Thor)"


@fix
def arkham_city_x87(game):
    """Batman: Arkham City (BatmanAC.exe, also started through BmLauncher.exe beside it) leans on x87
    and stops with Unreal's "Fatal error!" right after start when FEX reduces its precision."""
    if "batmanac.exe" in game.files:
        return {"FEX_X87REDUCEDPRECISION": "0"}, [], "Batman: Arkham City: FEX with full x87 precision"



@fix
def teardown_vsync(game):
    if game.stem == "teardown":
        return {"vblank_mode": "2"}, [], "Teardown: OpenGL keeps the game's own vsync"


@fix
def protonfixes_off(game):
    if game.stem in ("blackops3", "darksoulsremastered"):
        return {"PROTONFIXES_DISABLE": "1"}, [], "umu-protonfixes off (its ALSA audio and VC++ installer steps fail here)"


@fix
def caravan_sandwitch_feature_level(game):
    if "caravansandwitch.exe" in game.files or game.stem == "caravansandwitch-win64-shipping":
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "Caravan SandWitch: D3D12 feature level 12_1 (12_2 hands it mesh shader pipelines vkd3d-proton cannot build)"


@fix
def robocop_rogue_city_feature_level(game):
    """vkd3d-proton turns mesh shaders off on Adreno, but 12_2 still advertises them, and UE5 then builds mesh
    pipelines with no pipeline layout that crash Turnip on launch."""
    if "robocop.exe" in game.files or game.stem == "robocop-win64-shipping":
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "RoboCop: Rogue City: D3D12 feature level 12_1"


@fix
def reskate_feature_level(game):
    if "skate.exe" in game.files and "reskate.dll" in game.files:
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "ReSkate (skate.): D3D12 feature level 12_1"


@fix
def cyberpunk_feature_level(game):
    if game.stem == "cyberpunk2077" or (
        game.stem == "redprelauncher"
        and os.path.isfile(os.path.join(os.path.dirname(game.exe), "bin", "x64", "Cyberpunk2077.exe"))
    ):
        return {"VKD3D_FEATURE_LEVEL": "12_1"}, [], "Cyberpunk 2077: D3D12 feature level 12_1"

def skip_red_launcher(command):
    """Cyberpunk 2077's prelauncher opens REDlauncher, a Qt WebEngine window that hands over to the
    game half a minute later and then stays up beside it, well over a core busy for as long as the
    game runs. The game is started itself instead; the prelauncher's own --launcher-skip started it
    twice."""
    if len(command) > 2 and os.path.basename(command[2]).lower() == "redprelauncher.exe":
        game = os.path.join(os.path.dirname(command[2]), "bin", "x64", "Cyberpunk2077.exe")
        if os.path.isfile(game):
            print("droiddeck-game-env: REDlauncher skipped", file=sys.stderr)
            return command[:2] + [game] + command[3:]
    return command


UBISOFT_LAUNCHER = "drive_c/Program Files (x86)/Ubisoft/Ubisoft Game Launcher"
UBISOFT_SETTINGS = "drive_c/users/steamuser/AppData/Local/Ubisoft Game Launcher/settings.yaml"


def overlay_off(text):
    lines = text.splitlines()
    try:
        start = next(i for i, line in enumerate(lines) if re.fullmatch(r"overlay:\s*(#.*)?", line))
    except StopIteration:
        if lines and not lines[-1].strip():
            lines.pop()
        return "\n".join(lines + ["overlay:", "  enabled: false", "  warning_enabled: false"]) + "\n"
    end = start + 1
    for index in range(start + 1, len(lines)):
        if lines[index].strip() and not lines[index].startswith("  "):
            break
        if lines[index].strip():
            end = index + 1
    block = lines[start + 1:end]
    for key in ("enabled", "warning_enabled"):
        entry = "  %s: false" % key
        found = [i for i, line in enumerate(block) if line.split(":", 1)[0] == "  " + key]
        if found:
            block[found[0]] = entry
        else:
            block.append(entry)
    return "\n".join(lines[:start + 1] + block + lines[end:]) + "\n"


def ubisoft_overlay_off(env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    if not (prefix / UBISOFT_LAUNCHER).is_dir():
        return
    settings = prefix / UBISOFT_SETTINGS
    try:
        text = settings.read_text(encoding="utf-8") if settings.exists() else ""
        updated = overlay_off(text)
        if updated == text:
            return
        settings.parent.mkdir(parents=True, exist_ok=True)
        handle, staged = tempfile.mkstemp(prefix=".settings-", dir=settings.parent)
        try:
            with os.fdopen(handle, "w", encoding="utf-8") as target:
                target.write(updated)
            if settings.exists():
                os.chmod(staged, settings.stat().st_mode & 0o7777)
            os.replace(staged, settings)
        except BaseException:
            os.unlink(staged)
            raise
        print("droiddeck-game-env: Ubisoft Connect overlay turned off", file=sys.stderr)
    except (OSError, UnicodeDecodeError) as error:
        print("droiddeck-game-env: Ubisoft Connect overlay left as is (%s)" % error, file=sys.stderr)


def offline_without_anticheat(command, env):
    """Start the configured game executable when the player opts into launching without EAC."""
    if (env.get("DROIDDECK_ANTICHEAT_OFFLINE") != "1" or len(command) <= 2
            or command[1] != "waitforexitandrun"
            or not re.fullmatch(r"start_protected_game(?:_?x64|_?64)?\.exe",
                                os.path.basename(command[2]), re.IGNORECASE)):
        return command
    folder = os.path.dirname(command[2])
    try:
        with open(os.path.join(folder, "EasyAntiCheat", "settings.json"), encoding="utf-8-sig") as source:
            executable = json.load(source).get("executable")
    except (OSError, ValueError, AttributeError):
        return command
    if not isinstance(executable, str) or not executable:
        return command
    relative = os.path.normpath(executable.replace("\\", "/"))
    game = os.path.join(folder, relative)
    if os.path.isabs(relative) or relative.startswith("..") or not os.path.isfile(game):
        return command
    # Resolve symlinks before accepting an executable inside the game directory.
    root = os.path.realpath(folder)
    if os.path.commonpath((root, os.path.realpath(game))) != root:
        return command
    if os.path.normcase(os.path.abspath(game)) == os.path.normcase(os.path.abspath(command[2])):
        return command
    print("droiddeck-game-env: started without Easy Anti-Cheat (offline only)", file=sys.stderr)
    return command[:2] + [game] + command[3:]


def engine_fixes(exe, args):
    """Environment and extra arguments a game needs because of what it is built with."""
    game = Game(exe, args)
    env, extra, notes = {}, [], []
    for check in FIXES:
        found = check(game)
        if found:
            for name, value in found[0].items():
                if name == "WINEDLLOVERRIDES" and env.get(name):
                    value = env[name] + ";" + value
                env[name] = value
            extra += found[1]
            notes.append(found[2])
    return env, extra, notes


def win_components(compat, app_id):
    """The game's Windows components put into its prefix; returns their WINEDLLOVERRIDES entries."""
    if not compat:
        return ""
    try:
        module = runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-wincomponents"))
        names, notes = module["apply"](compat.rstrip("/"), app_id)
        for note in notes:
            print("droiddeck-game-env: " + note, file=sys.stderr)
        return module["overrides_value"](names)
    except Exception as error:
        print("droiddeck-game-env: Windows components not applied (%s)" % error, file=sys.stderr)
        return ""


def game_gpu(env):
    if GAME_TU_DEBUG not in env:
        return env
    result = env.copy()
    value = result.pop(GAME_TU_DEBUG)
    if value:
        result["TU_DEBUG"] = value
    else:
        result.pop("TU_DEBUG", None)
    return result


# Proven per-game environment defaults. These apply first, so the user's own
# shared and per-game settings always win over them. Entries are plain env
# names to values, except DXVK_CONFIG which is appended to like the user's
# own dxvkConfig below (DXVK lets the last setting for a key win).
BUILTIN_GAME_ENV = {
    # NARUTO SHIPPUDEN: Ultimate Ninja STORM 4. Locks the base frame rate to
    # 30 (the textbook base for 2x frame generation on a 60 Hz display) and
    # enables async pipeline compilation so first-time effects hitch for a
    # frame instead of dropping one.
    "349040": {
        "DXVK_CONFIG": "dxvk.maxFrameRate = 30",
        "DXVK_GPLASYNCCACHE": "1",
    },
}
def vram_cap(env):
    """Puts the session's VRAM cap ahead of the game's own DXVK settings, so a game profile can still raise it."""
    value = env.get("BL_VRAM_MB", "")
    if not re.fullmatch(r"[1-9][0-9]{0,6}", value):
        return env
    result = env.copy()
    cap = "dxgi.maxDeviceMemory = %d" % int(value)
    own = result.get("DXVK_CONFIG", "").strip().strip(";").strip()
    result["DXVK_CONFIG"] = cap + "; " + own if own else cap
    return result


def parse_cores(text):
    """CPU numbers from a list such as "0-3,6"; None when the text is not one."""
    cores = set()
    for part in text.replace(" ", "").split(","):
        match = re.fullmatch(r"(\d{1,3})(?:-(\d{1,3}))?", part)
        if not match:
            return None
        first, last = int(match.group(1)), int(match.group(2) or match.group(1))
        if last < first:
            return None
        cores.update(range(first, last + 1))
    return cores or None


def online_cores():
    try:
        with open("/sys/devices/system/cpu/online") as f:
            cores = parse_cores(f.read().strip())
    except OSError:
        cores = None
    return cores or os.sched_getaffinity(0) | set(range(os.cpu_count() or 0))


def game_cores(env):
    """Pins the game to the cores its profile names, in place of the session's game cores."""
    text = env.get("DROIDDECK_GAME_CORES", "").strip()
    if not text:
        return
    cores = parse_cores(text)
    chosen = cores & online_cores() if cores else None
    if not chosen:
        print("droiddeck-game-env: ignoring game cores %r" % text, file=sys.stderr)
        return
    try:
        os.sched_setaffinity(0, chosen)
        print("droiddeck-game-env: game cores %s" % ",".join(map(str, sorted(chosen))), file=sys.stderr)
    except OSError as error:
        print("droiddeck-game-env: could not use game cores %r (%s)" % (text, error), file=sys.stderr)


def core_speeds(cores, root="/sys/devices/system/cpu"):
    """Each core's capacity, else its top clock; None when some core reports neither."""
    for name in ("cpu_capacity", "cpufreq/cpuinfo_max_freq"):
        speeds = {}
        for core in cores:
            try:
                with open("%s/cpu%d/%s" % (root, core, name)) as f:
                    speeds[core] = int(f.read().strip())
            except (OSError, ValueError):
                break
        else:
            return speeds
    return None


def fastest_first(cores):
    """The cores, fastest first; cores of equal or unknown speed keep their numeric order."""
    cores = sorted(cores)
    speeds = core_speeds(cores)
    return sorted(cores, key=lambda core: -speeds[core]) if speeds else cores


def proton_cpu_limit(command, env):
    """This game's entry in Proton's own default_cpu_limit list: a core count, another value such as "P" as text, or None."""
    app_id = env.get("SteamGameId", "")
    if not command or not app_id.isdigit():
        return None
    try:
        if os.path.getsize(command[0]) > 4 * 1024 * 1024:
            return None
        with open(command[0], encoding="utf-8", errors="replace") as f:
            text = f.read()
    except OSError:
        return None
    table = re.search(r"^default_cpu_limit = \{(.*?)^\}", text, re.M | re.S)
    match = table and re.search(r'^\s*"%s"\s*:\s*"?(\w+)' % app_id, table.group(1), re.M)
    if not match:
        return None
    value = match.group(1)
    return int(value) if value.isdigit() else value


def cpu_topology(env, command=()):
    """Windows sees the game's cores fastest first, so a thread a game pins to CPU 0 runs on the fastest core."""
    if "PROTON_CPU_TOPOLOGY" in env:
        return
    if "WINE_CPU_TOPOLOGY" in env:
        if env["WINE_CPU_TOPOLOGY"]:
            env["PROTON_CPU_TOPOLOGY"] = env["WINE_CPU_TOPOLOGY"]
        return
    picked = bool(env.get("DROIDDECK_GAME_CORES", "").strip() or env.get("BL_GAME_CPUS", "").strip())
    fastest = env.get("DROIDDECK_FASTEST_CORES", "").strip() != "0" and game_id(env) is not None
    if not (picked or fastest):
        return
    try:
        cores = sorted(os.sched_getaffinity(0))
    except OSError:
        return
    online = online_cores()
    if not cores or cores[-1] >= len(online):
        return
    picked = picked and not set(cores) >= online
    if fastest:
        limit = None if picked else proton_cpu_limit(command, env)
        if isinstance(limit, str):
            return
        cores = fastest_first(cores)[:limit or None]
    elif set(cores) >= online:
        return
    if cores == sorted(online):
        return
    env["WINE_CPU_TOPOLOGY"] = env["PROTON_CPU_TOPOLOGY"] = "%d:%s" % (len(cores), ",".join(map(str, cores)))
    print("droiddeck-game-env: Windows sees %d cores (%s)" % (len(cores), env["WINE_CPU_TOPOLOGY"]), file=sys.stderr)


def gl_vsync(env):
    """OpenGL stops waiting for each screen refresh; Steam's Frame Limit still holds the game through gamescope."""
    # Wine asks for interval 1 on every GL window, and WineD3D's front-buffer drawing (DirectDraw,
    # Direct3D 1-7) never lowers it, so those games ran at the refresh rate with no limit set.
    if "vblank_mode" in env or game_id(env) is None:
        return False
    env["vblank_mode"] = "0"
    return True


def game_images(env):
    if game_id(env) is None:
        return False
    env.setdefault("GAMESCOPE_WSI_MIN_IMAGE_COUNT", "8")
    env.setdefault("GAMESCOPE_WSI_ENSURE_MIN_IMAGE_COUNT", "1")
    return True


def apply_config(env, config, app_id, fixes=None):
    if config.get("version") != 1:
        raise ValueError("unsupported environment configuration")
    result = env.copy()
    entries = dict(BUILTIN_GAME_ENV.get(app_id, {}))
    entries.update(config.get("shared", {}))
    for name, value in (fixes or {}).items():
        if name == "WINEDLLOVERRIDES" and entries.get(name, env.get(name)):
            value = entries.get(name, env.get(name)) + ";" + value
        entries[name] = value
    entries.update(config.get("games", {}).get(app_id, {}))
    for name, value in entries.items():
        if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", name):
            raise ValueError("invalid environment name")
        if value is None:
            result.pop(name, None)
        elif isinstance(value, str) and "\0" not in value and len(value) <= 8192:
            result[name] = value
        else:
            raise ValueError("invalid environment value")
    game_dxvk = config.get("dxvkConfigGames", {})
    if not isinstance(game_dxvk, dict):
        raise ValueError("invalid game dxvk configuration")
    dxvk = game_dxvk.get(app_id, config.get("dxvkConfig"))
    if dxvk is not None:
        if not isinstance(dxvk, str) or "\0" in dxvk or len(dxvk) > 8192:
            raise ValueError("invalid dxvk configuration")
        if dxvk:
            own = result.get("DXVK_CONFIG", "").strip().rstrip(";").strip()
            result["DXVK_CONFIG"] = own + "; " + dxvk if own else dxvk
    return result


GAME_DEBUG_CHANNELS = (
    "timestamp", "pid", "tid", "seh", "unwind", "threadname", "debugstr", "loaddll", "mscoree",
)
WINE_DEBUG_SELECTOR = re.compile(r"(?:(trace|warn|err|fixme))?([+-])([A-Za-z_][A-Za-z0-9_]*)")


def game_debug_channels(*values):
    """Normalize Wine selectors, retaining custom channels before required diagnostics."""
    selectors = {}
    for value in values:
        if not isinstance(value, str) or "\0" in value or len(value) > 8192:
            continue
        for part in value.split(","):
            part = part.strip()
            match = WINE_DEBUG_SELECTOR.fullmatch(part)
            if match is None:
                continue
            key = (match[1] or "", match[3])
            # Move the last value to the end: global +/-all and per-class selectors
            # have ordered semantics, so replacing a value in its old position is wrong.
            selectors.pop(key, None)
            selectors[key] = part
    for channel in GAME_DEBUG_CHANNELS:
        key = ("", channel)
        selectors.pop(key, None)
        selectors[key] = "+" + channel
    formatted = ",".join(selectors.values())
    if len(formatted) > 8192:
        formatted = ",".join("+" + channel for channel in GAME_DEBUG_CHANNELS)
    return formatted


def apply_game_debug_logs(env, config, debug_dir):
    """Apply app-owned diagnostics to a real game, without editing its launch command."""
    if not isinstance(config, dict) or config.get("version") != 1 or config.get("gameDebugLogs") is not True:
        return env
    if (not isinstance(debug_dir, str) or "\0" in debug_dir or len(debug_dir) > 8192
            or not os.path.isabs(debug_dir) or not os.path.isdir(debug_dir)):
        print("droiddeck-game-env: game debug logs skipped; session log directory unavailable", file=sys.stderr)
        return env
    result = dict(env)
    result.update({
        "PROTON_LOG": "1",
        "PROTON_LOG_DIR": debug_dir,
        "PROTON_CRASH_REPORT_DIR": debug_dir,
        "DXVK_LOG_PATH": debug_dir,
        "DXVK_LOG_LEVEL": "debug",
        "VKD3D_DEBUG": "info",
        "WINEDEBUG": game_debug_channels(env.get("WINEDEBUG"), env.get("PROTON_LOG")),
    })
    return result


def sync_config(config, app_id):
    games = config.get("games", {})
    return {
        "version": config.get("version"),
        "shared": {name: value for name, value in config.get("shared", {}).items() if name in SYNC_KEYS},
        "games": {app_id: {name: value for name, value in games.get(app_id, {}).items() if name in SYNC_KEYS}},
    }


def load_sync():
    try:
        return runpy.run_path(str(Path(__file__).resolve().parent / "droiddeck-esync"))
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
        return None


def select_sync(command, env, sync=None):
    try:
        sync = sync if sync is not None else load_sync()
        if sync is None:
            return command, env
        chosen, chosen_env = sync["select"](command, env)
        if chosen and all(isinstance(value, str) for value in chosen) and isinstance(chosen_env, dict):
            return list(chosen), dict(chosen_env)
    except Exception as error:
        print("droiddeck-game-env: sync selection failed (%s); stock launch" % error, file=sys.stderr)
    return command, env


def record_stock(sync, command, env):
    try:
        if sync is not None and "record" in sync:
            sync["record"](command, env)
    except Exception as error:
        print("droiddeck-game-env: stock launch not recorded (%s)" % error, file=sys.stderr)


def without_pack(chosen_env, env):
    result = dict(chosen_env)
    for name in PACK_KEYS:
        if name in env:
            result[name] = env[name]
        else:
            result.pop(name, None)
    return result


SSBS_LIB = "/usr/local/lib/libssbs.so"


def force_ssbs(command, env):
    """DROIDDECK_FORCE_SSBS=1 (a game's or the shared environment): preload libssbs.so into this
    Proton's Wine, which then keeps PSTATE.SSBS set across signal returns - speculative store
    bypass stays allowed, as force_ssbs.diff does inside a rebuilt ntdll. ARM64 Protons only: the
    library is aarch64 and only arm64 Wine has the signal path it fixes."""
    if env.get("DROIDDECK_FORCE_SSBS", "").lower() not in ("1", "on", "true", "yes"):
        return env
    proton = os.path.dirname(command[0]) if command else ""
    if not os.path.isdir(os.path.join(proton, "files/lib/wine/aarch64-unix")):
        print("droiddeck-game-env: force SSBS asked for, but this Proton is not an ARM64 one; left off", file=sys.stderr)
        return env
    if not os.path.isfile(SSBS_LIB):
        print("droiddeck-game-env: force SSBS asked for, but %s is missing; left off" % SSBS_LIB, file=sys.stderr)
        return env
    parts = [p for p in re.split(r"[:\s]+", env.get("LD_PRELOAD", "")) if p]
    if SSBS_LIB not in parts:
        env = dict(env, LD_PRELOAD=":".join(parts + [SSBS_LIB]))
        print("droiddeck-game-env: force SSBS on (libssbs.so preloaded)", file=sys.stderr)
    return env


def umu_capable(proton):
    """Whether this Proton's script has umu's launch without Steam: GE-Proton, Proton-CachyOS and
    DroidDeck-Proton run umu.exe in place of steam.exe when UMU_ID is set; Valve's Proton does not."""
    try:
        with open(proton, encoding="utf-8", errors="replace") as source:
            text = source.read()
    except OSError:
        return False
    return "UMU_ID" in text and "umu.exe" in text


def start_without_steam(command, env, app_id):
    """DROIDDECK_NO_STEAM=1 (a game's Start without Steam): launch the game without Proton's
    steam.exe, for games that close right away because of what it sets up. A Proton with umu's
    launch gets UMU_ID - Proton still sets up the prefix, and a Steam game keeps its protonfixes
    under its own id; any other Proton runs the game straight in the prefix (runinprefix)."""
    if env.get("DROIDDECK_NO_STEAM", "").lower() not in ("1", "on", "true", "yes"):
        return command, env
    if len(command) < 3 or command[1] != "waitforexitandrun":
        return command, env
    if umu_capable(command[0]):
        if not env.get("UMU_ID"):
            steam_game = app_id is not None and int(app_id) < 2**31
            env = dict(env, UMU_ID=app_id if steam_game else "0")
        print("droiddeck-game-env: starting without Steam (umu.exe in place of steam.exe, UMU_ID=%s)" % env["UMU_ID"], file=sys.stderr)
        return command, env
    print("droiddeck-game-env: starting without Steam (this Proton has no umu launch: runinprefix)", file=sys.stderr)
    return [command[0], "runinprefix"] + command[2:], env


EVALUATOR_SCRIPT = re.compile(r"(?:^|[\\/])evaluatorscript_[0-9]+\.vdf$", re.IGNORECASE)


def mark_install_scripts(command, env):
    """The client is about to run a game's install scripts (iscriptevaluator.exe): mark every process
    in them but a Vulkan runtime installer as already run first, so no redistributable installer
    starts - on first launch the shared ones may still be downloading, and on ARM64 Proton the VC++
    ones stop with an error."""
    if not any(arg.lower().replace("\\", "/").endswith("iscriptevaluator.exe") for arg in command):
        return []
    root = env.get("BL_X64_STEAM_ROOT") or env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or str(Path.home() / ".local/share/Steam")
    scripts = [str(Path(root) / arg.replace("\\", "/")) for arg in command if EVALUATOR_SCRIPT.search(arg)]
    scripts = [path for path in scripts if os.path.isfile(path)]
    if not scripts:
        return []
    try:
        subprocess.run([SEED_REDISTS, root], env=dict(env, DROIDDECK_SEED_SCRIPTS="\n".join(scripts)),
                       stdout=sys.stderr, timeout=60, check=False)
    except (OSError, subprocess.SubprocessError) as error:
        print("droiddeck-game-env: install scripts not marked (%s)" % error, file=sys.stderr)
    return scripts


INSTALL_STAMP = ".droiddeck-install-scripts"
VDF_TOKEN = re.compile(r'"((?:[^"\\]|\\.)*)"|([{}])')


def read_vdf(text):
    tokens = iter(VDF_TOKEN.findall(text))

    def block():
        items = []
        for word, brace in tokens:
            if brace == "}":
                return items
            if brace:
                raise ValueError("a block without a name")
            value, opens = next(tokens, ("", "}"))
            if opens == "}":
                raise ValueError("a name without a value")
            items.append((re.sub(r"\\(.)", r"\1", word), block() if opens else re.sub(r"\\(.)", r"\1", value)))
        return items

    return block()


def run_keys(items, appid=""):
    appid = next((value for name, value in items if name.lower() == "appid" and isinstance(value, str)), appid)
    found = set()
    for name, value in items:
        if not isinstance(value, list):
            continue
        if any(isinstance(v, str) and re.fullmatch(r"process [0-9]+", n.lower()) for n, v in value):
            key = next((v for n, v in value if n.lower() == "hasrunkey" and isinstance(v, str)),
                       "HKEY_LOCAL_MACHINE\\Software\\Valve\\Steam\\Apps\\" + appid)
            found.add((key.lower(), name.lower()))
        found |= run_keys(value, appid)
    return found


def registry_values(path):
    found, section = set(), None
    with open(path, encoding="utf-8", errors="replace") as reg:
        for line in reg:
            if line.startswith("["):
                section = line[1:line.find("]")].replace("\\\\", "\\").lower() if "]" in line else None
            elif section and line.startswith('"') and '"=' in line:
                found.add((section, line[1:line.index('"=')].replace("\\\\", "\\").lower()))
    return found


def has_run(key, value, values):
    path = key[len("hkey_local_machine\\"):] if key.startswith("hkey_local_machine\\") else None
    if path is None:
        return False
    views = [path]
    if path.startswith("software\\"):
        views.append("software\\wow6432node\\" + path[len("software\\"):])
    return any((view, value) in values for view in views)


def scripts_digest(scripts):
    digest = hashlib.sha256()
    for path in sorted(scripts):
        digest.update(os.path.basename(path).encode() + b"\0")
        digest.update(Path(path).read_bytes())
    return digest.hexdigest()


def install_scripts_done(scripts, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if (prefix / INSTALL_STAMP).read_text().strip() != scripts_digest(scripts):
            return False
        keys = set()
        for path in scripts:
            keys |= run_keys(read_vdf(Path(path).read_text(encoding="utf-8", errors="replace")))
        values = registry_values(prefix / "system.reg")
    except (OSError, ValueError):
        return False
    return bool(keys) and all(has_run(key, value, values) for key, value in keys)


def record_install_scripts(digest, env):
    prefix = Path(env.get("STEAM_COMPAT_DATA_PATH", "/nonexistent")) / "pfx"
    try:
        if prefix.is_dir():
            staged = prefix / (INSTALL_STAMP + ".tmp")
            staged.write_text(digest + "\n")
            staged.replace(prefix / INSTALL_STAMP)
    except OSError as error:
        print("droiddeck-game-env: install scripts not recorded (%s)" % error, file=sys.stderr)


def directaudio_settings(env):
    if "directaudio" not in env.get("WINE_AUDIO_DRIVER", "").split(","):
        return env
    for name, value in list(env.items()):
        if name.startswith("AUDIO_DIRECT_"):
            env["BANNER_" + name] = value
    return env


def sync_off(env):
    return env.get("DROIDDECK_SYNC", "").strip().lower() in SYNC_OFF


def describe_status(status):
    if status < 0:
        return "killed by signal %d" % -status
    return "exit code %d" % status


def game_folder(app_id):
    """Where this session keeps what a game said: the folder the app collects with the session's
    logs. None outside a session, or when it cannot be made."""
    debug = os.environ.get("BL_DEBUG_DIR", "").strip()
    if not debug or not app_id:
        return None
    folder = Path(debug) / "games"
    try:
        folder.mkdir(parents=True, exist_ok=True)
    except OSError:
        return None
    return folder


class GameLog:
    """A launch's own account of itself, kept per app while it runs.

    A game that stops in its first seconds has said why somewhere - Unity writes Player.log, Wine
    writes an err:seh line with the fault or an err:module line naming a library it could not load,
    DXVK and the Vulkan layers write to the same stream - and none of it survives a session today:
    the launcher execs Proton, so the game's output only reaches the session log, which is trimmed
    to the last megabytes of the session and thrown away with it. This keeps the same output beside
    the session's artifacts, by app, whatever happens to the game.
    """

    def __init__(self, app_id):
        self.app_id = app_id or "0"
        self.folder = game_folder(app_id)
        self.path = (self.folder / (self.app_id + ".log")) if self.folder else None
        self.head = []
        self.written = 0

    def note(self, text):
        print(text, file=sys.stderr)
        self.head.append(text)

    def start(self, command, env, exe):
        lines = ["== %s  app %s" % (time.strftime("%Y-%m-%d %H:%M:%S"), self.app_id),
                 "   command: " + " ".join(command),
                 "   exe: " + (exe or "-"),
                 "   install: " + (env.get("STEAM_COMPAT_INSTALL_PATH") or "-"),
                 "   prefix: " + (env.get("STEAM_COMPAT_DATA_PATH") or "-")]
        lines += ["   " + text for text in self.head]
        lines += ["   %s=%s" % (name, env[name]) for name in DEBUG_KEYS if env.get(name)]
        self._write(("\n".join(lines) + "\n").encode("utf-8", "replace"))

    def output(self, data, channel="err"):
        stream = sys.stdout.buffer if channel == "out" else sys.stderr.buffer
        try:
            stream.write(data)
            stream.flush()
        except (OSError, ValueError):
            pass
        self._write(data)

    def stopped(self, status, seconds):
        self.record("droiddeck-game-env: app %s stopped after %.1f s (%s)" % (self.app_id, seconds, describe_status(status)))

    def record(self, text):
        """A line of this engine's own into the game's log as well: what the engine concluded is the
        first thing to read in it, and it has to survive the session log being trimmed."""
        print(text, file=sys.stderr)
        self._write(("\n" + text + "\n").encode("utf-8", "replace"))

    def _write(self, data):
        if self.path is None or self.written >= GAME_LOG_CAP:
            return
        if self.written + len(data) > GAME_LOG_CAP:
            data = data[:GAME_LOG_CAP - self.written] + b"\n...(the rest of this log was dropped)...\n"
        try:
            with self.path.open("ab") as sink:
                sink.write(data)
        except OSError:
            return
        self.written += len(data)


def prefix_files(pfx):
    """The files a game in this prefix wrote where Unity and Wine leave theirs: the game's own log,
    what it wrote to its crash folder, and Wine's dumps under the user's Temp. Read-only and
    bounded - the prefix is the user's, not this session's."""
    users = Path(pfx) / "drive_c" / "users"
    found = []
    scanned = 0
    if not users.is_dir():
        return found
    for user in sorted(users.iterdir()):
        for root, crashes in ((user / "AppData" / "LocalLow", True), (user / "AppData" / "Local" / "Temp", False)):
            if not root.is_dir():
                continue
            for base, _, names in os.walk(root):
                for name in sorted(names):
                    scanned += 1
                    if scanned > SCAN_LIMIT:
                        return sorted(set(found))
                    path = Path(base) / name
                    low = name.lower()
                    if low in UNITY_LOGS or low.endswith(".dmp") or (crashes and "crashes" in [p.lower() for p in path.parts]):
                        found.append(path)
    return sorted(set(found))


def keep_files(folder, app_id, sources, cap=ARTIFACT_CAP):
    """Copies what a game left behind into the session's artifacts - the tail of each file, since a
    log ends with what went wrong - and returns (source, kept name, bytes) for the record."""
    kept = []
    total = 0
    for path in sources:
        if len(kept) >= ARTIFACTS_LIMIT or total >= ARTIFACTS_TOTAL:
            break
        try:
            data = path.read_bytes()
        except OSError:
            continue
        if len(data) > cap:
            data = b"...(older output dropped)...\n" + data[-cap:]
        name = "%s-%s" % (app_id, path.name.lower())
        index = 1
        while (folder / name).exists():
            index += 1
            name = "%s-%d-%s" % (app_id, index, path.name.lower())
        try:
            (folder / name).write_bytes(data)
        except OSError:
            continue
        kept.append((str(path), name, len(data)))
        total += len(data)
    return kept


def proton_logs(app_id):
    """Proton's own log of a launch (PROTON_LOG=1), the one place where Wine's errors, the Vulkan
    layers and the game's setup are kept together."""
    home = Path.home()
    candidates = [home / ("steam-%s.log" % app_id), home / "steam.log"] if app_id else [home / "steam.log"]
    return [path for path in candidates if path.is_file()]


def signature(path):
    """Valve's own steam_api64.dll carries an Authenticode signature; the Steamworks emulators a
    repack leaves in its place are patched copies of it and are not signed, which is what tells the
    two apart here."""
    try:
        with path.open("rb") as source:
            head = source.read(0x40)
            if len(head) < 0x40 or head[:2] != b"MZ":
                return "not a PE file"
            offset = int.from_bytes(head[0x3C:0x40], "little")
            source.seek(offset)
            header = source.read(0x120)
    except OSError as error:
        return "unreadable (%s)" % error
    if len(header) < 0x78 or header[:4] != b"PE\x00\x00":
        return "not a PE file"
    magic = int.from_bytes(header[24:26], "little")
    table = 24 + (96 if magic == 0x10B else 112) + 4 * 8
    if table + 8 > len(header):
        return "no data directories"
    return "signed" if int.from_bytes(header[table + 4:table + 8], "little") else "unsigned"


def sizeof(bytes_):
    value = float(bytes_)
    for unit in ("bytes", "KB", "MB", "GB", "TB"):
        if value < 1024 or unit == "TB":
            return "%d %s" % (value, unit) if unit == "bytes" else "%.1f %s" % (value, unit)
        value /= 1024.0


def install_path(env, exe):
    return env.get("STEAM_COMPAT_INSTALL_PATH") or (os.path.dirname(exe) if exe else "")


def manifest_for(env, app_id):
    """This app's manifest, wherever the library that holds its install keeps it: the one place the
    size of what should be on disk is written down."""
    if not app_id:
        return ""
    root = Path(env.get("STEAM_COMPAT_CLIENT_INSTALL_PATH") or (Path.home() / ".local/share/Steam"))
    name = "appmanifest_%s.acf" % app_id
    candidates = [root / "steamapps" / name]
    try:
        vdf = (root / "steamapps/libraryfolders.vdf").read_text(encoding="utf-8", errors="replace")
    except OSError:
        vdf = ""
    for path in VDF_PATH.findall(vdf):
        candidates.append(Path(path.replace("\\\\", "\\")) / "steamapps" / name)
    for candidate in candidates:
        try:
            return candidate.read_text(encoding="utf-8", errors="replace")
        except OSError:
            continue
    return ""


def measure(path, limit=MEASURE_LIMIT, budget=MEASURE_SECONDS):
    """Bytes and files under a game's folder. Bounded by both, because an install can hold a hundred
    thousand files and this runs after each of its launches."""
    deadline = time.monotonic() + budget
    total = 0
    files = 0
    stack = [str(path)]
    while stack:
        try:
            entries = os.scandir(stack.pop())
        except OSError:
            continue
        with entries:
            for entry in entries:
                try:
                    if entry.is_dir(follow_symlinks=False):
                        stack.append(entry.path)
                        continue
                    if not entry.is_file(follow_symlinks=False):
                        continue
                    total += entry.stat(follow_symlinks=False).st_size
                except OSError:
                    continue
                files += 1
                if files > limit or (files % 512 == 0 and time.monotonic() > deadline):
                    return total, files, True
    return total, files, False


def bundles_missing(folder):
    """Unity's Addressables catalog against the bundles beside it. The catalog names every bundle
    the game will ask for, so what is not in the folder is what it cannot load, and the names say
    which part of the game never arrived."""
    for catalog in sorted(Path(folder).glob("*_Data/StreamingAssets/aa/catalog.json")):
        try:
            data = json.loads(catalog.read_text(encoding="utf-8", errors="replace"))
        except (OSError, ValueError):
            continue
        ids = data.get("m_InternalIds")
        if not isinstance(ids, list):
            continue
        named = set()
        for item in ids:
            if isinstance(item, str):
                name = item.replace("\\", "/").rsplit("/", 1)[-1]
                if name.endswith(".bundle"):
                    named.add(name)
        bundles = catalog.parent / "StandaloneWindows64"
        try:
            present = {entry.name for entry in bundles.iterdir()}
        except OSError:
            present = set()
        missing = sorted(named - present)
        if not named or not missing:
            continue
        groups = {}
        for name in missing:
            key = "_".join(BUNDLE_TAIL.sub("", name).split("_")[:2]).strip("_") or name
            groups[key] = groups.get(key, 0) + 1
        top = sorted(groups.items(), key=lambda pair: (-pair[1], pair[0]))[:6]
        return len(missing), len(named), bundles.name, ["%s x%d" % (key, count) for key, count in top]
    return None


def content_report(env, app_id, path, budget=MEASURE_SECONDS):
    """What the folder holds against what its own record says it should. A game whose files are not
    all there stops the moment it loads one of them, and Steam never repairs this by itself: the
    manifest it reads is the one the copied install brought with it."""
    lines = []
    short = ""
    root = Path(path) if path else None
    if root is not None and root.is_dir():
        text = manifest_for(env, app_id)
        expected = ACF_SIZE.search(text)
        if expected:
            build = ACF_BUILD.search(text)
            expected_bytes = int(expected.group(1))
            total, files, capped = measure(root, budget=budget)
            lines.append("content: the manifest%s records %d bytes; the folder holds %d in %d files%s"
                         % (" of build %s" % build.group(1) if build else "", expected_bytes, total, files,
                            " (counting stopped at %d files)" % files if capped else ""))
            if not capped and expected_bytes - total > SHORT_BYTES and total < expected_bytes * SHORT_TOLERANCE:
                lines.append("content: %s of it is not there, and Steam will not ask for it: the manifest it "
                             "reads records that build as installed, so the client has no reason to fetch it"
                             % sizeof(expected_bytes - total))
                short = "%s of its %s install is not there" % (sizeof(expected_bytes - total), sizeof(expected_bytes))
        found = bundles_missing(root)
        if found:
            missing, named, folder_name, groups = found
            lines.append("addressables: the game's own catalog names %d bundles; %d of them are not in %s (%s)"
                         % (named, missing, folder_name, ", ".join(groups)))
            short = ("%s, and " % short if short else "") + \
                "%d of the %d bundles the game's own catalog names are missing" % (missing, named)
    return lines, short


def install_report(env, exe):
    """The game's own folder as this launch finds it: what Steam put there, and anything a repack
    left beside it. Every launch keeps one with the session's artifacts, because a game that closes
    right away is often a game whose folder was written by something other than Steam - the crack's
    steamclient64.dll shadows the client library Proton provides, and SteamAPI_Init is then the last
    thing the game does before it exits."""
    path = install_path(env, exe)
    lines = ["install: " + (path or "-")]
    if not path:
        return lines
    folder = Path(path)
    try:
        entries = sorted(folder.iterdir(), key=lambda entry: entry.name.lower())
    except OSError as error:
        return lines + ["not listable (%s)" % error]
    if os.path.islink(path):
        lines.append("symlink to: " + os.path.realpath(path))
    for entry in entries[:200]:
        try:
            info = entry.stat(follow_symlinks=False)
        except OSError:
            continue
        lines.append("  %s %10d %s" % ("d" if entry.is_dir() else "f", info.st_size, entry.name))
    found = sorted(entry.name for entry in entries if entry.name.lower() in EMULATOR_FILES)
    if found:
        lines.append("steam emulator files: " + ", ".join(found))
    for name in STEAM_LIBRARIES:
        candidate = folder / name
        if candidate.is_file():
            lines.append("  %s %10d %s: %s" % ("s", candidate.stat().st_size, name, signature(candidate)))
    return lines


def keep_artifacts(log, env, exe, budget=MEASURE_SECONDS):
    """Keeps what a launch left behind with the session's artifacts: the game's own logs and dumps,
    Proton's log, and a listing of its folder as the launch found it. Returns what the folder is
    short of, when it is short of anything."""
    if log.folder is None:
        return ""
    pfx = os.path.join(env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/"), "pfx")
    kept = keep_files(log.folder, log.app_id, prefix_files(pfx))
    kept += keep_files(log.folder, log.app_id, proton_logs(log.app_id), cap=PROTON_LOG_CAP)
    for source, name, size in kept:
        log.note("droiddeck-game-env: kept %s (%d bytes) as %s" % (source, size, name))
    path = install_path(env, exe)
    content, short = content_report(env, log.app_id, path, budget)
    try:
        (log.folder / (log.app_id + "-install.txt")).write_text(
            "\n".join(install_report(env, exe) + content) + "\n", encoding="utf-8")
    except OSError:
        pass
    return short


def start(launch, env):
    return subprocess.Popen(launch, env=env, stdin=subprocess.DEVNULL,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE)


def follow(child, log):
    """Reads the game's output until the launch ends, then waits for it. Each stream keeps its own
    side of this process's output, so a launcher that reads the game's stdout still gets it. The
    pipes are dropped once the launch's own process is gone even if something it started still holds
    them open, so a leftover process cannot keep the client waiting for a game that has stopped."""
    previous = {}

    def forward(signum, frame):
        try:
            child.send_signal(signum)
        except OSError:
            pass

    for name in ("SIGTERM", "SIGINT", "SIGHUP"):
        previous[name] = signal.signal(getattr(signal, name), forward)
    streams = {child.stdout: "out", child.stderr: "err"}
    try:
        while streams:
            ready, _, _ = select.select(list(streams), [], [], 0.25)
            if ready:
                for stream in ready:
                    chunk = os.read(stream.fileno(), 65536)
                    if chunk:
                        log.output(chunk, streams[stream])
                    else:
                        streams.pop(stream, None)
                continue
            if child.poll() is not None:
                for stream in list(streams):
                    while select.select([stream], [], [], 0)[0]:
                        chunk = os.read(stream.fileno(), 65536)
                        if not chunk:
                            break
                        log.output(chunk, streams[stream])
                break
    except (OSError, ValueError):
        pass
    finally:
        for name, handler in previous.items():
            signal.signal(getattr(signal, name), handler)
    return child.wait()


def kill_server(command, env):
    """Stops a Wine server still running for this prefix. A server left over from the previous
    launch is reused whichever binaries the next one names, so a launch that asks for different
    ones has to end it first to be what it says it is."""
    prefix = env.get("STEAM_COMPAT_DATA_PATH", "").rstrip("/")
    server = os.path.join(os.path.dirname(command[0]), "files", "bin", "wineserver")
    if not prefix or not os.path.isfile(server):
        return
    print("droiddeck-game-env: ending the Wine server still running for this prefix", file=sys.stderr)
    try:
        subprocess.run([server, "-k"], env=dict(env, WINEPREFIX=os.path.join(prefix, "pfx")), timeout=30,
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def pick_launch(command, env, sync, note=print):
    """The command and environment to run, and the sync choice behind them: the pack's when the
    selector chose one, the stock pair when it did not - and always the stock pair, with the sync
    libraries taken out, when the game's own environment asks for sync off."""
    if sync_off(env):
        note("droiddeck-game-env: sync off for this game (asked for in its environment); stock launch")
        kill_server(command, env)
        return command, without_pack(env, env), None
    launch, launch_env = select_sync(command, env, sync)
    return launch, launch_env, (sync if launch[0] != command[0] else None)


def main():
    command = sys.argv[1:]
    if not command:
        return 2
    env = game_gpu(os.environ.copy())
    mic_enabled = env.get("BL_MIC_ENABLED")
    debug_dir = env.get("BL_DEBUG_DIR", "")
    scripts = mark_install_scripts(command, env)
    if scripts and install_scripts_done(scripts, env):
        print("droiddeck-game-env: install scripts already run in this prefix; evaluator skipped", file=sys.stderr)
        return 0
    try:
        digest = scripts_digest(scripts) if scripts else None
    except OSError:
        digest = None
    app_id = game_id(env)
    log = GameLog(app_id)
    if app_id:
        gl_default = gl_vsync(env)
        waiting = len(command) > 1 and command[1] == "waitforexitandrun"
        if waiting:
            game_images(env)
        fixes = {}
        if waiting:
            if not env.get("WINEDEBUG"):
                env["WINEDEBUG"] = WINEDEBUG_GAMES
            command = skip_red_launcher(command)
            ubisoft_overlay_off(env)
            fixes, extra, notes = engine_fixes(command[2], command[3:]) if len(command) > 2 else ({}, [], [])
            if not gl_default:
                fixes.pop("vblank_mode", None)
            for note in notes:
                log.note("droiddeck-game-env: " + note)
            command += extra
            components = win_components(env.get("STEAM_COMPAT_DATA_PATH", ""), app_id)
            if components:
                own = fixes.get("WINEDLLOVERRIDES")
                fixes["WINEDLLOVERRIDES"] = components + ";" + own if own else components
        path = Path.home() / ".config/droiddeck/game-environment.json"
        config = {}
        try:
            with path.open(encoding="utf-8") as source:
                config = json.load(source)
            if waiting:
                if "vblank_mode" in config.get("shared", {}):
                    fixes.pop("vblank_mode", None)
                env = apply_config(env, config, app_id, fixes)
            else:
                env = apply_config(env, sync_config(config, app_id), app_id)
        except FileNotFoundError:
            if waiting:
                env = apply_config(env, {"version": 1}, app_id, fixes)
        except (OSError, ValueError, TypeError, AttributeError):
            print("droiddeck-game-env: invalid configuration; using inherited environment", file=sys.stderr)
        if waiting:
            before_debug = env
            env = apply_game_debug_logs(env, config, debug_dir)
            if env is not before_debug:
                print("droiddeck-game-env: game debug logs enabled for this launch", file=sys.stderr)
        if gl_default and env.get("vblank_mode") == "0":
            print("droiddeck-game-env: OpenGL does not wait for the screen refresh (vblank_mode=0)", file=sys.stderr)
    if app_id and len(command) > 1 and command[1] == "waitforexitandrun":
        command = offline_without_anticheat(command, env)
    if mic_enabled == "0":
        env["AUDIO_DIRECT_MIC"] = "0"
    env = directaudio_settings(env)
    env = vram_cap(env)
    env = force_ssbs(command, env)
    command, env = start_without_steam(command, env, app_id)
    game_cores(env)
    cpu_topology(env, command)
    exe = command[2] if len(command) > 2 else ""
    try:
        xbox = runpy.run_path(str(Path(__file__).with_name("droiddeck-xbox")))
    except Exception as error:
        print("droiddeck-game-env: Xbox support unavailable (%s); stock launch" % error, file=sys.stderr)
        xbox = {"launch": lambda command, env: None}
    try:
        xbox_result = xbox["launch"](command, env)
    except (OSError, ValueError, KeyError, RuntimeError) as error:
        print("droiddeck-game-env: Xbox launch could not start (%s)" % error, file=sys.stderr)
        return 1
    if xbox_result is not None:
        return xbox_result
    sync = load_sync()
    launch, launch_env, chosen_sync = pick_launch(command, env, sync, log.note)
    log.start(launch, launch_env, exe)
    began = time.monotonic()
    try:
        child = start(launch, launch_env)
    except OSError as error:
        if chosen_sync is None:
            raise
        log.note("droiddeck-game-env: %s could not start (%s); stock launch" % (launch[0], error))
        launch, launch_env = command, without_pack(launch_env, env)
        record_stock(sync, launch, launch_env)
        child = start(launch, launch_env)
    status = follow(child, log)
    if digest and status == 0:
        record_install_scripts(digest, launch_env)
    seconds = time.monotonic() - began
    log.stopped(status, seconds)
    budget = MEASURE_SECONDS if seconds < QUICK_STOP else MEASURE_SECONDS_QUIET
    short = keep_artifacts(log, launch_env, exe, budget)
    if short and seconds < QUICK_STOP:
        log.record("droiddeck-game-env: app %s stopped after %.1f s, and %s - a launch cannot get past files "
                   "that are not there (see games/%s-install.txt)" % (log.app_id, seconds, short, log.app_id))
    return status if status >= 0 else 128 - status


if __name__ == "__main__":
    sys.exit(main())
